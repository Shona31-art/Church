# Copy this file to .env.local (never commit .env.local — it's git-ignored).

# --- Supabase (required) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public "anon" key. Safe in the browser: RLS decides what it can touch.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses RLS. Used for registration, inviting/deleting members,
# audit logging and POPIA exports. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Journal encryption (required for the Journal) ---------------------------
# 32-byte key as 64 hex chars for AES-256-GCM. Generate: openssl rand -hex 32
# Losing or changing this makes existing journal entries unreadable.
JOURNAL_ENCRYPTION_KEY=

# --- AI (optional) -----------------------------------------------------------
# Powers sermon summaries, prayer verses & drafts, counseling replies, poster
# taglines, quiz generation, Bible study and the announcement writer.
# Leave blank and every feature still works with its non-AI fallback.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=
# Per-person hourly cap on AI requests, to protect the API bill (default 30).
AI_CALLS_PER_USER_PER_HOUR=30

# --- Card giving via Paystack (optional — see README "Card giving") ---------
# Server only, never NEXT_PUBLIC_. Use the test key (sk_test_...) until you're
# ready for real payments. Blank = card giving hidden; bank transfers still work.
PAYSTACK_SECRET_KEY=
# Optional: Paystack's card fee for South African cards, copied from their
# pricing page, so members can choose to add it. Blank = option hidden.
# PERCENT e.g. 2.9 ; FLAT_CENTS e.g. 100 for R1.00
PAYSTACK_FEE_PERCENT=
PAYSTACK_FEE_FLAT_CENTS=
# Online billing (optional): Paystack plan codes for church subscriptions.
# Create two monthly ZAR plans in Paystack (Products → Plans) with the same
# prices as Basic and Premium in the plans table, and paste their codes here.
# Blank = billing stays manual (plan changes through Super Admin / support).
PAYSTACK_PLAN_BASIC=
PAYSTACK_PLAN_PREMIUM=

# Base URL used for payment returns (Paystack) and invite/reset email links.
# Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Timezone (optional) ------------------------------------------------------
# The servers run in UTC; dates and event times are shown and entered in this
# timezone. One timezone per deployment. Default: Africa/Johannesburg.
NEXT_PUBLIC_APP_TIMEZONE=Africa/Johannesburg

# --- Notifications (optional; free-first) -------------------------------------
# Leave blank: alerts (crisis escalations etc.) show in the app only — R0.
# Set to a Make.com / n8n / Zapier webhook to send email or WhatsApp from
# there. The app sends IDs only, never confidential content.
NOTIFY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Notify-Secret header so the webhook
# can reject calls that didn't come from this app.
NOTIFY_WEBHOOK_SECRET=

# --- Scheduled jobs ------------------------------------------------------------
# Shared secret for Vercel Cron (vercel.json). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" when it calls /api/cron/*; anything
# else is refused. Without it, the nightly job that deletes 90-day-old voice
# notes never runs (chat still works; storage just grows). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Notification pop-ups (optional; free) ---------------------------------------
# The notification bell works without these. They add phone/computer pop-ups
# (Web Push) — see README "Notification pop-ups" for the full set-up.
# Generate the key pair once per environment with:
#   pnpm exec web-push generate-vapid-keys
# The PUBLIC key is safe in the browser; the PRIVATE key is a secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services can use about abuse: mailto:you@yourchurch.org
VAPID_SUBJECT=
# Shared secret the Supabase Database Webhook sends as the x-webhook-secret
# header to /api/notifications/push. Generate like CRON_SECRET above.
NOTIFICATIONS_WEBHOOK_SECRET=

# --- Poster editor: free stock photos (optional; free) -------------------------
# Pexels API key (sign up free at https://www.pexels.com/api/). Lets poster makers
# search free stock photos in the editor. Blank = the "Free photos" tab explains
# it isn't set up; uploads still work. Server only: never prefix with NEXT_PUBLIC_.
PEXELS_API_KEY=

# --- Error tracking (optional; Sentry's free Developer plan is enough) ----------
# Sentry project DSN (Project Settings → Client Keys). When set, server errors
# (every console.error) and browser errors are sent to Sentry; blank = server
# log only, as before. Messages are scrubbed of emails and phone numbers, and
# no request bodies or user details are sent. Any Sentry-compatible service
# (e.g. self-hosted GlitchTip) works. Server only: never prefix with NEXT_PUBLIC_.
SENTRY_DSN=
# Optional label, e.g. "preview". Defaults to Vercel's environment name.
SENTRY_ENVIRONMENT=
