# Copy this file to .env.local (never commit .env.local — it's git-ignored).

# --- Supabase (required) ------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public "anon" key. Safe in the browser: RLS decides what it can touch.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses RLS. Used for registration, inviting/deleting members,
# audit logging and POPIA exports. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Journal encryption (required for the Journal) ---------------------------
# 32-byte key as 64 hex chars for AES-256-GCM. Generate: openssl rand -hex 32
# Losing or changing this makes existing journal entries unreadable.
JOURNAL_ENCRYPTION_KEY=

# --- AI (optional) -----------------------------------------------------------
# Powers sermon summaries, prayer verses & drafts, counseling replies, poster
# taglines, quiz generation, Bible study and the announcement writer.
# Leave blank and every feature still works with its non-AI fallback.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=
# Per-person hourly cap on AI requests, to protect the API bill (default 30).
AI_CALLS_PER_USER_PER_HOUR=30

# --- Stripe billing (optional; test mode is free — see README) ---------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=

# Base URL used for Stripe redirects and invite/reset email links.
# Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Timezone (optional) ------------------------------------------------------
# The servers run in UTC; dates and event times are shown and entered in this
# timezone. One timezone per deployment. Default: Africa/Johannesburg.
NEXT_PUBLIC_APP_TIMEZONE=Africa/Johannesburg

# --- Notifications (optional; free-first) -------------------------------------
# Leave blank: alerts (crisis escalations etc.) show in the app only — R0.
# Set to a Make.com / n8n / Zapier webhook to send email or WhatsApp from
# there. The app sends IDs only, never confidential content.
NOTIFY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Notify-Secret header so the webhook
# can reject calls that didn't come from this app.
NOTIFY_WEBHOOK_SECRET=

# --- Scheduled jobs ------------------------------------------------------------
# Shared secret for Vercel Cron (vercel.json). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" when it calls /api/cron/*; anything
# else is refused. Without it, the nightly job that deletes 90-day-old voice
# notes never runs (chat still works; storage just grows). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
